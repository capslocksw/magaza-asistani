{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magaza-contracts.bundle.json",
  "title": "MagazaContracts",
  "description": "DO NOT EDIT. Generated by packages/contracts/scripts/generate.mjs from packages/contracts/schemas.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "AnalyticsEventType": {
      "$ref": "#/$defs/AnalyticsEventType"
    },
    "AnalyticsEvent": {
      "$ref": "#/$defs/AnalyticsEvent"
    },
    "BrowserEventName": {
      "$ref": "#/$defs/BrowserEventName"
    },
    "CartLine": {
      "$ref": "#/$defs/CartLine"
    },
    "AddToCartDetail": {
      "$ref": "#/$defs/AddToCartDetail"
    },
    "OrderLine": {
      "$ref": "#/$defs/OrderLine"
    },
    "Order": {
      "$ref": "#/$defs/Order"
    },
    "ProductSpec": {
      "$ref": "#/$defs/ProductSpec"
    },
    "Product": {
      "$ref": "#/$defs/Product"
    },
    "ProductCard": {
      "$ref": "#/$defs/ProductCard"
    },
    "ComplementRule": {
      "$ref": "#/$defs/ComplementRule"
    },
    "DocChunk": {
      "$ref": "#/$defs/DocChunk"
    },
    "ChatRequest": {
      "$ref": "#/$defs/ChatRequest"
    },
    "BundleItem": {
      "$ref": "#/$defs/BundleItem"
    },
    "Bundle": {
      "$ref": "#/$defs/Bundle"
    },
    "SourceRef": {
      "$ref": "#/$defs/SourceRef"
    },
    "ChatUsage": {
      "$ref": "#/$defs/ChatUsage"
    },
    "TokenEvent": {
      "$ref": "#/$defs/TokenEvent"
    },
    "ProductsEvent": {
      "$ref": "#/$defs/ProductsEvent"
    },
    "BundleEvent": {
      "$ref": "#/$defs/BundleEvent"
    },
    "ActionEvent": {
      "$ref": "#/$defs/ActionEvent"
    },
    "SourceEvent": {
      "$ref": "#/$defs/SourceEvent"
    },
    "DoneEvent": {
      "$ref": "#/$defs/DoneEvent"
    },
    "ErrorEvent": {
      "$ref": "#/$defs/ErrorEvent"
    },
    "SseEvent": {
      "$ref": "#/$defs/SseEvent"
    },
    "QuoteItem": {
      "$ref": "#/$defs/QuoteItem"
    },
    "QuoteRequest": {
      "$ref": "#/$defs/QuoteRequest"
    },
    "QuoteResponse": {
      "$ref": "#/$defs/QuoteResponse"
    },
    "ClientEvent": {
      "$ref": "#/$defs/ClientEvent"
    },
    "TenantId": {
      "$ref": "#/$defs/TenantId"
    },
    "Sku": {
      "$ref": "#/$defs/Sku"
    },
    "Currency": {
      "$ref": "#/$defs/Currency"
    },
    "Origin": {
      "$ref": "#/$defs/Origin"
    },
    "PersonaTemplate": {
      "$ref": "#/$defs/PersonaTemplate"
    },
    "PersonaSettings": {
      "$ref": "#/$defs/PersonaSettings"
    },
    "TenantTheme": {
      "$ref": "#/$defs/TenantTheme"
    },
    "TenantActions": {
      "$ref": "#/$defs/TenantActions"
    },
    "CatalogSource": {
      "$ref": "#/$defs/CatalogSource"
    },
    "TenantQuotas": {
      "$ref": "#/$defs/TenantQuotas"
    },
    "TopicDefinition": {
      "$ref": "#/$defs/TopicDefinition"
    },
    "TenantConfig": {
      "$ref": "#/$defs/TenantConfig"
    },
    "WidgetPublicConfig": {
      "$ref": "#/$defs/WidgetPublicConfig"
    }
  },
  "$defs": {
    "AnalyticsEventType": {
      "title": "AnalyticsEventType",
      "description": "visit = widget script loaded for a visitor (denominator for assisted vs. unassisted conversion).",
      "enum": [
        "visit",
        "widget_open",
        "user_message",
        "agent_message",
        "tool_call",
        "product_shown",
        "add_to_cart",
        "quote_request",
        "order",
        "feedback"
      ]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event_type",
        "tenant_id",
        "session_id",
        "visitor_id_hash",
        "ts",
        "model",
        "tokens_in",
        "tokens_out",
        "latency_ms",
        "cost_usd_est",
        "is_synthetic",
        "payload"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "event_type": {
          "$ref": "#/$defs/AnalyticsEventType"
        },
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "visitor_id_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{16,64}$"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "cost_usd_est": {
          "type": "number",
          "minimum": 0
        },
        "is_synthetic": {
          "type": "boolean"
        },
        "payload": {
          "type": "object",
          "description": "Event specific fields; PII is masked before the event is written."
        }
      }
    },
    "BrowserEventName": {
      "title": "BrowserEventName",
      "description": "window CustomEvent names exchanged between the storefront and the widget.",
      "enum": [
        "ma:add-to-cart",
        "ma:ready",
        "ma:open",
        "ma:close"
      ]
    },
    "CartLine": {
      "title": "CartLine",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "title",
        "price",
        "qty"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "title": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "image_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "AddToCartDetail": {
      "title": "AddToCartDetail",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "items"
      ],
      "description": "detail of the `ma:add-to-cart` CustomEvent dispatched on window by the widget.",
      "properties": {
        "source": {
          "const": "magaza-asistani"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "bundle_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CartLine"
          },
          "minItems": 1
        }
      }
    },
    "OrderLine": {
      "title": "OrderLine",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "qty",
        "price"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "price": {
          "type": "number"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_id",
        "items",
        "total",
        "currency"
      ],
      "description": "Argument of window.MagazaAsistani.trackOrder(order), called by the storefront on order confirmation.",
      "properties": {
        "order_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OrderLine"
          },
          "minItems": 1
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      }
    },
    "ProductSpec": {
      "title": "ProductSpec",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "title",
        "brand",
        "category",
        "category_name",
        "description",
        "price",
        "currency",
        "stock",
        "unit",
        "image_url",
        "url",
        "specs",
        "tags",
        "complement_skus"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "brand": {
          "type": "string"
        },
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "category_name": {
          "type": "string"
        },
        "subcategory": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "price": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "list_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "stock": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "image_url": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "specs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductSpec"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "complement_skus": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "SKUs of complementary products (referential integrity is checked by the data tests)."
        },
        "doc_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "doc_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "rating": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5
        },
        "review_count": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "sales_rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "max_installments": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "free_shipping": {
          "type": "boolean",
          "default": false
        },
        "gtin": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ProductCard": {
      "title": "ProductCard",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "title",
        "brand",
        "price",
        "currency",
        "image_url",
        "url",
        "in_stock"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "title": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "list_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        },
        "image_url": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "in_stock": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short reason why the assistant recommends it."
        }
      }
    },
    "ComplementRule": {
      "title": "ComplementRule",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "source_category",
        "target_category",
        "reason",
        "priority"
      ],
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "source_category": {
          "type": "string"
        },
        "source_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Rule applies only to source products carrying at least one of these tags (empty = whole category)."
        },
        "target_category": {
          "type": "string"
        },
        "target_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "reason": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DocChunk": {
      "title": "DocChunk",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "doc_id",
        "title",
        "text",
        "order",
        "source_url"
      ],
      "properties": {
        "chunk_id": {
          "type": "string"
        },
        "doc_id": {
          "type": "string"
        },
        "sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "source_url": {
          "type": "string"
        }
      }
    },
    "ChatRequest": {
      "title": "ChatRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "visitor_id"
      ],
      "description": "Body of POST /v1/t/{public_key}/chat. The tenant comes from the verified public key + Origin, never from the body.",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9_-]{8,64}$"
        },
        "visitor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "page_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "cart_skus": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "default": []
        }
      }
    },
    "BundleItem": {
      "title": "BundleItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "title",
        "price",
        "qty",
        "role",
        "image_url",
        "url"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "title": {
          "type": "string"
        },
        "price": {
          "type": "number"
        },
        "qty": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "main",
            "complement"
          ]
        },
        "image_url": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Bundle": {
      "title": "Bundle",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_id",
        "title",
        "rationale",
        "items",
        "total",
        "currency"
      ],
      "properties": {
        "bundle_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BundleItem"
          },
          "minItems": 1
        },
        "total": {
          "type": "number"
        },
        "currency": {
          "$ref": "#/$defs/Currency"
        }
      }
    },
    "SourceRef": {
      "title": "SourceRef",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "title",
        "url"
      ],
      "properties": {
        "doc_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ChatUsage": {
      "title": "ChatUsage",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "tokens_in",
        "tokens_out",
        "latency_ms"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "tokens_in": {
          "type": "integer",
          "minimum": 0
        },
        "tokens_out": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "TokenEvent": {
      "title": "TokenEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "token"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "ProductsEvent": {
      "title": "ProductsEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "products"
      ],
      "properties": {
        "type": {
          "const": "products"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProductCard"
          }
        }
      }
    },
    "BundleEvent": {
      "title": "BundleEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bundle"
      ],
      "properties": {
        "type": {
          "const": "bundle"
        },
        "bundle": {
          "$ref": "#/$defs/Bundle"
        }
      }
    },
    "ActionEvent": {
      "title": "ActionEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "action"
      ],
      "properties": {
        "type": {
          "const": "action"
        },
        "action": {
          "enum": [
            "suggest_quote",
            "quote_created"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object",
          "default": {}
        }
      }
    },
    "SourceEvent": {
      "title": "SourceEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sources"
      ],
      "properties": {
        "type": {
          "const": "source"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SourceRef"
          }
        }
      }
    },
    "DoneEvent": {
      "title": "DoneEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "session_id",
        "message_id"
      ],
      "properties": {
        "type": {
          "const": "done"
        },
        "session_id": {
          "type": "string"
        },
        "message_id": {
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChatUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ErrorEvent": {
      "title": "ErrorEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "code",
        "message"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "invalid_request",
            "origin_not_allowed",
            "unknown_tenant",
            "rate_limited",
            "quota_exceeded",
            "internal"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    },
    "SseEvent": {
      "title": "SseEvent",
      "description": "One server-sent event of the chat stream. Wire format: `event: <type>` + `data: <json>`.",
      "oneOf": [
        {
          "$ref": "#/$defs/TokenEvent"
        },
        {
          "$ref": "#/$defs/ProductsEvent"
        },
        {
          "$ref": "#/$defs/BundleEvent"
        },
        {
          "$ref": "#/$defs/ActionEvent"
        },
        {
          "$ref": "#/$defs/SourceEvent"
        },
        {
          "$ref": "#/$defs/DoneEvent"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        }
      ]
    },
    "QuoteItem": {
      "title": "QuoteItem",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "qty"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/Sku"
        },
        "qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "QuoteRequest": {
      "title": "QuoteRequest",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visitor_id",
        "company_name",
        "contact_name",
        "email",
        "items"
      ],
      "properties": {
        "visitor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "contact_name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QuoteItem"
          },
          "minItems": 1,
          "maxItems": 50
        },
        "note": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    },
    "QuoteResponse": {
      "title": "QuoteResponse",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote_id",
        "status"
      ],
      "properties": {
        "quote_id": {
          "type": "string"
        },
        "status": {
          "const": "received"
        }
      }
    },
    "ClientEvent": {
      "title": "ClientEvent",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "visitor_id"
      ],
      "description": "Body of POST /v1/t/{public_key}/events (widget -> agent-api). Converted server-side into an AnalyticsEvent.",
      "properties": {
        "event_type": {
          "enum": [
            "visit",
            "widget_open",
            "product_shown",
            "add_to_cart",
            "order",
            "feedback"
          ]
        },
        "visitor_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{8,128}$"
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object",
          "default": {}
        }
      }
    },
    "TenantId": {
      "title": "TenantId",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Tenant slug. Always taken from server-verified context, never from client input or model output."
    },
    "Sku": {
      "title": "Sku",
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[A-Z0-9]{2,5}-[0-9]{3,6}$"
    },
    "Currency": {
      "title": "Currency",
      "type": "string",
      "const": "TRY"
    },
    "Origin": {
      "title": "Origin",
      "type": "string",
      "pattern": "^https?://[^/\\s]+$",
      "description": "Scheme + host (+ port), no trailing slash."
    },
    "PersonaTemplate": {
      "title": "PersonaTemplate",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "name",
        "description",
        "instruction",
        "version"
      ],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,40}$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "instruction": {
          "type": "string",
          "description": "Instruction template. Placeholders: {{store_name}}, {{assistant_name}}, {{actions}}, {{tone_notes}}, {{extra_instructions}}."
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "PersonaSettings": {
      "title": "PersonaSettings",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_id",
        "assistant_name",
        "greeting",
        "suggested_questions"
      ],
      "properties": {
        "template_id": {
          "type": "string"
        },
        "assistant_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "tone_notes": {
          "type": "string",
          "default": ""
        },
        "extra_instructions": {
          "type": "string",
          "default": ""
        },
        "greeting": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "suggested_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        }
      }
    },
    "TenantTheme": {
      "title": "TenantTheme",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_color",
        "accent_color",
        "text_on_primary",
        "launcher_label"
      ],
      "properties": {
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text_on_primary": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "logo_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "launcher_label": {
          "type": "string",
          "maxLength": 40
        },
        "position": {
          "enum": [
            "right",
            "left"
          ],
          "default": "right"
        }
      }
    },
    "TenantActions": {
      "title": "TenantActions",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "add_to_cart",
        "quote_request"
      ],
      "properties": {
        "add_to_cart": {
          "type": "boolean"
        },
        "quote_request": {
          "type": "boolean"
        }
      }
    },
    "CatalogSource": {
      "title": "CatalogSource",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "feed_url"
      ],
      "properties": {
        "type": {
          "const": "merchant_feed"
        },
        "feed_url": {
          "type": "string",
          "description": "Google Merchant XML feed (http(s) URL, or a file path in local dev)."
        },
        "docs_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "Folder or bucket with the technical data sheets (PDF)."
        },
        "last_synced_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "TenantQuotas": {
      "title": "TenantQuotas",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_messages",
        "messages_per_session",
        "requests_per_minute_per_visitor"
      ],
      "properties": {
        "monthly_messages": {
          "type": "integer",
          "minimum": 0
        },
        "messages_per_session": {
          "type": "integer",
          "minimum": 1
        },
        "requests_per_minute_per_visitor": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "TopicDefinition": {
      "title": "TopicDefinition",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topic_id",
        "label",
        "keywords"
      ],
      "properties": {
        "topic_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]{2,40}$"
        },
        "label": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "TenantConfig": {
      "title": "TenantConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "display_name",
        "status",
        "public_key",
        "allowed_origins",
        "persona",
        "theme",
        "actions",
        "catalog",
        "quotas",
        "holdout_pct",
        "sku_pattern",
        "topic_taxonomy"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "#/$defs/TenantId"
        },
        "display_name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "suspended"
          ]
        },
        "public_key": {
          "type": "string",
          "pattern": "^pk_[a-z0-9_]{6,64}$"
        },
        "allowed_origins": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Exact origins (scheme://host[:port], no trailing slash) allowed to embed the widget."
        },
        "persona": {
          "$ref": "#/$defs/PersonaSettings"
        },
        "theme": {
          "$ref": "#/$defs/TenantTheme"
        },
        "actions": {
          "$ref": "#/$defs/TenantActions"
        },
        "catalog": {
          "$ref": "#/$defs/CatalogSource"
        },
        "quotas": {
          "$ref": "#/$defs/TenantQuotas"
        },
        "holdout_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "Share of visitors (percent) in the control group; the widget stays hidden for them."
        },
        "sku_pattern": {
          "type": "string",
          "description": "Regex the grounding guardrail uses to find SKUs in answers."
        },
        "topic_taxonomy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TopicDefinition"
          }
        },
        "created_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "WidgetPublicConfig": {
      "title": "WidgetPublicConfig",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "assistant_name",
        "greeting",
        "suggested_questions",
        "theme",
        "actions",
        "group"
      ],
      "properties": {
        "display_name": {
          "type": "string"
        },
        "assistant_name": {
          "type": "string"
        },
        "greeting": {
          "type": "string"
        },
        "suggested_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theme": {
          "$ref": "#/$defs/TenantTheme"
        },
        "actions": {
          "$ref": "#/$defs/TenantActions"
        },
        "group": {
          "enum": [
            "assistant",
            "control"
          ],
          "description": "Holdout assignment for this visitor."
        }
      }
    }
  }
}
