{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Common",
  "$defs": {
    "TenantId": {
      "title": "TenantId",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,40}$",
      "description": "Tenant slug. Always taken from server-verified context, never from client input or model output."
    },
    "Sku": {
      "title": "Sku",
      "type": "string",
      "pattern": "^[A-Z]{2,4}-[A-Z0-9]{2,5}-[0-9]{3,6}$"
    },
    "Currency": {
      "title": "Currency",
      "type": "string",
      "const": "TRY"
    },
    "Origin": {
      "title": "Origin",
      "type": "string",
      "pattern": "^https?://[^/\\s]+$",
      "description": "Scheme + host (+ port), no trailing slash."
    }
  }
}
