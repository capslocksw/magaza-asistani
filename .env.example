# Copy to .env.local (git-ignored). Never commit real credentials.

# --- LLM ---
# fake  -> deterministic FakeLlm (no network, default for local dev/tests)
# vertex -> real Gemini on Vertex AI (requires GOOGLE_CLOUD_PROJECT + Application Default Credentials)
LLM_MODE=fake
# fake  -> local hashing embedder; vertex -> paid gemini-embedding-001 (re-embeds the catalog on every seed)
EMBEDDING_MODE=fake
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west1
# Model IDs / prices / the hard spend cap live in config/llm.yaml, not here (ADR 007; `make budget` shows spend).
# LLM_SPEND_LEDGER=.local/llm-spend.sqlite

# --- Firestore ---
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
FIRESTORE_PROJECT_ID=demo-magaza

# --- Services ---
AGENT_API_PORT=8080
ADMIN_API_PORT=8090
# Empty AGENT_URL -> widget talks to the scripted mock-agent (http://localhost:8787)
AGENT_URL=
# Local only: skip Firebase Auth verification in admin-api
DEV_AUTH_BYPASS=1
ANALYTICS_BACKEND=duckdb
ANALYTICS_DUCKDB_PATH=data/analytics/fixture.duckdb
